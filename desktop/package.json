{
  "name": "kaku",
  "productName": "Kaku",
  "version": "1.0.0",
  "description": "Japanese kana, kanji, vocabulary and Genki lesson practice",
  "author": "Troy Stokoe",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "test": "node test-store.js && node test-sync.js && node test-certs.js && node test-offline.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ca.stokoe.kaku",
    "productName": "Kaku",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "sync-server.js",
      "sw.js",
      "WEBLLM-LICENSE.txt",
      "webllm.js",
      "cert-store.js",
      "certs.js",
      "merge.js",
      "app.html",
      "fonts/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Kaku"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    }
  }
}